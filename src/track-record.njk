  <tbody>
    {%- for row in trackRecord %}
    <tr{% if row.Ticker == "AVERAGE" %} class="track-average"{% endif %}>
      <td>{{ row.Ticker }}</td>
      <td>{{ row.Type }}</td>
      <td>{{ row["Date of publishing"] }}</td>
      <td>{{ row["Time of publishing"] }}</td>
      <td>{{ row["Price at time of publishing"] }}</td>
      {%- for day in range(0, 6) %}
      <td>{% if row["Closing Price Day " + day] %}{{ row["Closing Price Day " + day] }}{% endif %}{% if row["Closing Price Day " + day + " % change"] %} <span class="pct{% if row["Closing Price Day " + day + " % change"][0] == "-" %} neg{% else %} pos{% endif %}">({{ row["Closing Price Day " + day + " % change"] }}%)</span>{% endif %}</td>
      {%- endfor %}
    </tr>
    {%- endfor %}
  </tbody>
</table>
</div>


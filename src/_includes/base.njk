<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}Utopia Capital Research</title>
  <meta name="description" content="{{ description or 'Activist short sellers and veteran traders. Countertrend research on volatile small and mid-cap US equities.' }}">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><img src="/wp-content/uploads/2020/08/ucr_logo_white_smallwide.png" alt="Utopia Capital Research" width="182" height="62"></a>
      <nav>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/legal-disclaimer/">Legal Disclaimer</a>
        <a href="/contact/">Contact</a>
        <a href="/track-record/">Track Record</a>
        <a href="/publications/">Publications</a>
        <a href="/about-short-selling/">About Short Selling</a>
        <a href="/membership/">Membership</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ currentYear }} Utopia Capital Research. Not investment advice. See our <a href="/legal-disclaimer/">Legal Disclaimer</a> and <a href="/privacy-policy/">Privacy Policy</a>.</p>
    </div>
  </footer>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}Utopia Capital Research</title>
  <meta name="description" content="{{ description or 'Activist short sellers and veteran traders. Countertrend research on volatile small and mid-cap US equities.' }}">
  <link rel="icon" href="/wp-content/uploads/2020/08/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/wp-content/uploads/2020/08/favicon-192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/wp-content/uploads/2020/08/favicon-192.png">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><img src="/wp-content/uploads/2020/08/ucr_logo_white_smallwide.png" alt="Utopia Capital Research" width="182" height="62"></a>
      <nav>
        <a href="/">Home</a>
        <details class="nav-dropdown">
          <summary>About</summary>
          <div class="nav-dropdown-menu">
            <a href="/about/">About</a>
            <a href="/legal-disclaimer/">Legal Disclaimer</a>
            <a href="/contact/">Contact</a>
          </div>
        </details>
        <a href="/track-record/">Track Record</a>
        <details class="nav-dropdown">
          <summary>Publications</summary>
          <div class="nav-dropdown-menu">
            <a href="/publications/">Publications</a>
            <a href="/blockchain-short-reports-2/">Blockchain Short Reports</a>
            <a href="/blockchain-trade-alerts/">Blockchain Trade Alerts</a>
            <a href="/investor-warnings/">Investor Warnings</a>
          </div>
        </details>
        <a href="/membership/">Membership</a>
        <details class="nav-dropdown">
          <summary>About Short Selling</summary>
          <div class="nav-dropdown-menu">
            <a href="/the-basics-of-short-selling/">Basics of Short Selling</a>
            <a href="/a-short-history-of-short-selling/">A Short History of Short Selling</a>
            <a href="/short-selling-in-the-public-eye/">Short Selling in the Public Eye</a>
            <a href="/why-you-should-learn-about-short-selling/">Why You Should Learn About Short Selling</a>
          </div>
        </details>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ currentYear }} Utopia Capital Research. Not investment advice. See our <a href="/legal-disclaimer/">Legal Disclaimer</a> and <a href="/privacy-policy/">Privacy Policy</a>. Follow us on <a href="https://x.com/utopiacap" target="_blank" rel="noopener">X</a>.</p>
    </div>
  </footer>

  <script>
  (function () {
    var links = document.querySelectorAll('a.join-cta');
    if (!links.length) return;

    var overlay = document.createElement('div');
    overlay.className = 'modal-overlay';
    overlay.hidden = true;
    overlay.innerHTML =
      '<div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="waitlist-modal-title">' +
        '<button type="button" class="modal-close" aria-label="Close">&times;</button>' +
        '<h3 id="waitlist-modal-title">Currently closed for new members</h3>' +
        '<p>We\'re not accepting new members right now. Email us and we\'ll add you to the waiting list for when spots open back up.</p>' +
        '<p><a class="btn-readmore" href="mailto:research@utopiacap.com?subject=Waiting%20list">Email us to join the waiting list</a></p>' +
      '</div>';
    document.body.appendChild(overlay);

    function openModal() { overlay.hidden = false; }
    function closeModal() { overlay.hidden = true; }

    links.forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        openModal();
      });
    });
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target.closest('.modal-close')) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  })();
  </script>
</body>
</html>

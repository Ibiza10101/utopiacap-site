---
layout: base.njk
title: Publications
permalink: /publications/
bodyClass: "publications-page"
---
<h1>Publications</h1>
<p>Every short report, trade alert and investor warning we've published, newest first.</p>
<div class="pub-grid">
  {% for post in collections.posts %}
  <a class="pub-card" href="{{ post.url }}">
    {% if post.data.coverImage %}
    <div class="pub-card-image" style="background-image: url('{{ post.data.coverImage }}');"></div>
    {% endif %}
    <div class="pub-card-body">
      <h3>{{ post.data.title }}</h3>
      <span class="pub-card-readmore">Read more</span>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time>
    </div>
  </a>
  {% endfor %}
</div>
